rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth != null;
    }

    // Public readable site settings & content, writable only by Robson (Admin)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public visible photos and categories
    match /photos/{photoId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Services
    match /services/{serviceId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read: if resource.data.visible == true || isAdmin();
      allow write: if isAdmin();
    }

    // Bookings (Agendamentos):
    // Public clients can ONLY create a booking (with validated fields).
    // Client personal data (name, phone, email) is strictly protected and readable ONLY by Robson (Admin).
    match /bookings/{bookingId} {
      allow create: if request.resource.data.clientName is string
                    && request.resource.data.clientWhatsApp is string
                    && request.resource.data.clientEmail is string
                    && request.resource.data.date is string
                    && request.resource.data.timeSlot is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
