# GEMINI_API_KEY: Optional - Injected by AI Studio if using Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (Vite Client Env Vars)
# Obtenha estas chaves criando um projeto no Firebase Console (firebase.google.com).
# Se estas chaves não forem preenchidas, a aplicação roda normalmente em MODO DEMONSTRAÇÃO.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
